# ---- Data (tracked by DVC, not Git) ----
/data/raw/*
/data/processed/*
!/data/raw/.gitkeep
!/data/processed/.gitkeep
*.csv
*.db
*.sqlite
*.sqlite3
!configs/*.csv

# ---- Model artifacts (tracked by DVC / MLflow) ----
/models/*
!/models/.gitkeep
*.pkl
*.joblib
*.h5
*.onnx

# ---- MLflow ----
mlruns/
mlartifacts/
mlflow.db

# ---- DVC ----
/.dvc/cache
/.dvc/tmp
/.dvc/plots

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ---- Environments ----
venv/
.venv/
env/
.env
.python-version

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ---- Logs ----
*.log
logs/
!reports/*.log

# .dvc pointer files MUST stay visible to Git - they are the version record
!/data/raw/*.dvc
!/data/processed/*.dvc
# Append these lines to your existing .gitignore (do NOT replace the file).
# In Git Bash:
#   cat GITIGNORE_APPEND.txt >> .gitignore
# then delete this file.

# MLflow local tracking store
# Artifacts are large and every run is reproducible from its logged config,
# so the store itself is not version-controlled. The comparison and audit
# JSONs in reports/ ARE committed - they are the evidence.
mlruns/
mlartifacts/
FINAL_CHECKLIST.md
